# ─── Environment Variables ───────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# Neon Postgres — Pooled connection (PgBouncer transaction mode)
# Used for all application queries (API + worker)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — Direct connection (session mode)
# Required for: migrations (npm run migrate) and LISTEN/NOTIFY relay
DATABASE_DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — minimum 32 characters, use a random string in production
JWT_SECRET=change-me-to-a-secure-32-char-minimum-secret

# API server
PORT=3000
NODE_ENV=development

# Worker configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_STALE_THRESHOLD_SECONDS=30
WORKER_REAPER_INTERVAL_MS=30000

# Dashboard dev server
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
