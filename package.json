{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Production-inspired distributed job scheduling platform",
  "workspaces": [
    "packages/*",
    "api",
    "worker",
    "dashboard"
  ],
  "scripts": {
    "migrate": "tsx migrations/migrate.ts",
    "dev:api": "npm run dev --workspace=api",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p migrations/tsconfig.json",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "test:coverage": "vitest run --workspace vitest.workspace.ts --coverage",
    "verify": "npm run typecheck && npm test && npm run build",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
